# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Model selection (any Responses-API model id works; also overridable per run
# with --model on the CLI)
# MARKETING_MODEL=gpt-5.6-terra
# MARKETING_FACTCHECK_MODEL=gpt-5.6-luna

# --- Phase 2: distribution & notifications (all optional) ---
# Approval notifications (either or both)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# TELEGRAM_BOT_TOKEN=123:abc
# TELEGRAM_CHAT_ID=123456

# Channel adapters (referenced from brands/<product>/channels.json)
# TYPEFULLY_API_KEY=...
# RESEND_API_KEY=re_...
# GSC_CREDENTIALS_FILE=/path/to/service-account.json  (needs: pip install google-auth)
